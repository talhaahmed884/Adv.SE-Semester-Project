title Studently - Controller Layer (REST API)\\n(Builder Pattern + Dependency Injection + Global Exception Handling)

' ============================================
' BUILDER PATTERN - Response Wrappers
' ============================================
package "Builder Pattern - API Response Wrappers" <<Rectangle>> #LightBlue {
    class "ApiSuccessResponse<T>" as ApiSuccessResponse {
        - data: T
        - message: String
        - statusCode: int
        - timestamp: LocalDateTime
        --
        # ApiSuccessResponse(builder: ApiSuccessResponseBuilder<T>)
        + {static} builder(): ApiSuccessResponseBuilder<T>
        + getData(): T
        + getMessage(): String
        + getStatusCode(): int
        + getTimestamp(): LocalDateTime
    }

    class "ApiSuccessResponseBuilder<T>" as ApiSuccessResponseBuilder {
        # data: T
        # message: String
        # statusCode: int = 200
        # timestamp: LocalDateTime = LocalDateTime.now()
        --
        + data(data: T): ApiSuccessResponseBuilder<T>
        + message(message: String): ApiSuccessResponseBuilder<T>
        + statusCode(statusCode: int): ApiSuccessResponseBuilder<T>
        + timestamp(timestamp: LocalDateTime): ApiSuccessResponseBuilder<T>
        + build(): ApiSuccessResponse<T>
    }

    class ErrorResponseDTO {
        - code: String
        - message: String
        - statusCode: int
        - path: String
        - timestamp: LocalDateTime
        - details: List<String>
        - fieldErrors: Map<String, String>
        --
        # ErrorResponseDTO(builder: ErrorResponseDTOBuilder)
        + {static} builder(): ErrorResponseDTOBuilder
        + getCode(): String
        + getMessage(): String
        + getStatusCode(): int
        + getPath(): String
        + getTimestamp(): LocalDateTime
        + getDetails(): List<String>
        + getFieldErrors(): Map<String, String>
    }

    class ErrorResponseDTOBuilder {
        - code: String
        - message: String
        - statusCode: int
        - path: String
        - timestamp: LocalDateTime = LocalDateTime.now()
        - details: List<String>
        - fieldErrors: Map<String, String>
        --
        + code(code: String): ErrorResponseDTOBuilder
        + message(message: String): ErrorResponseDTOBuilder
        + statusCode(statusCode: int): ErrorResponseDTOBuilder
        + path(path: String): ErrorResponseDTOBuilder
        + timestamp(timestamp: LocalDateTime): ErrorResponseDTOBuilder
        + addDetail(detail: String): ErrorResponseDTOBuilder
        + fieldErrors(fieldErrors: Map<String, String>): ErrorResponseDTOBuilder
        + build(): ErrorResponseDTO
    }

    ApiSuccessResponse --> ApiSuccessResponseBuilder : creates
    ApiSuccessResponseBuilder ..> ApiSuccessResponse : builds
    ErrorResponseDTO --> ErrorResponseDTOBuilder : creates
    ErrorResponseDTOBuilder ..> ErrorResponseDTO : builds

    note right of ApiSuccessResponse
        Builder Pattern:
        Generic response wrapper <T>
        Used by ALL controllers

        Example:
        ApiSuccessResponse.<UserDTO>builder()
            .data(userDTO)
            .message("User created")
            .statusCode(201)
            .build()
    end note

    note right of ErrorResponseDTO
        Builder Pattern:
        Structured error response
        Supports field-level errors
        Used by GlobalExceptionHandler
    end note
}

