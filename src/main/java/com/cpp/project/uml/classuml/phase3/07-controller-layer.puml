' ============================================
' EXCEPTION HANDLING - GLOBAL
' ============================================
package "Global Exception Handling" <<Rectangle>> #LightPink {
    class GlobalExceptionHandler <<@RestControllerAdvice>> {
        - {static} logger: Logger
        --
        + handleBaseException(ex: BaseException, request: WebRequest): ResponseEntity<ErrorResponseDTO>
        + handleValidationException(ex: MethodArgumentNotValidException, request: WebRequest): ResponseEntity<ErrorResponseDTO>
        + handleHttpMessageNotReadable(ex: HttpMessageNotReadableException, request: WebRequest): ResponseEntity<ErrorResponseDTO>
        + handleMethodNotSupported(ex: HttpRequestMethodNotSupportedException, request: WebRequest): ResponseEntity<ErrorResponseDTO>
        + handleMissingParams(ex: MissingServletRequestParameterException, request: WebRequest): ResponseEntity<ErrorResponseDTO>
        + handleGlobalException(ex: Exception, request: WebRequest): ResponseEntity<ErrorResponseDTO>
        --
        - getRequestPath(request: WebRequest): String
    }

    note right of GlobalExceptionHandler
        @RestControllerAdvice
        Catches ALL exceptions globally

        Exception Hierarchy:
        1. BaseException → Domain exceptions
        2. MethodArgumentNotValidException
        3. HttpMessageNotReadableException
        4. HttpRequestMethodNotSupportedException
        5. MissingServletRequestParameterException
        6. Generic Exception → 500 error

        Returns structured ErrorResponseDTO
        with code, message, statusCode, path,
        timestamp, details, fieldErrors

        170 LOC
    end note
}

' ============================================
' EXCEPTION HANDLING - DOMAIN SPECIFIC
' ============================================
package "Domain Exception Handlers" <<Rectangle>> #MistyRose {
    abstract class ExceptionHandler {
        # {abstract} canHandle(exception: Exception): boolean
        # {abstract} doHandle(exception: Exception): void
    }

    class AuthenticationExceptionHandler {
        - {static} logger: Logger
        --
        # canHandle(exception: Exception): boolean
        # doHandle(exception: Exception): void
    }

    class UserExceptionHandler {
        - {static} logger: Logger
        --
        # canHandle(exception: Exception): boolean
        # doHandle(exception: Exception): void
    }

    class CourseExceptionHandler {
        - {static} logger: Logger
        --
        # canHandle(exception: Exception): boolean
        # doHandle(exception: Exception): void
    }

    class ToDoListExceptionHandler {
        - {static} logger: Logger
        --
        # canHandle(exception: Exception): boolean
        # doHandle(exception: Exception): void
    }

    class TimerExceptionHandler {
        - {static} logger: Logger
        --
        # canHandle(exception: Exception): boolean
        # doHandle(exception: Exception): void
    }

    class CalendarExceptionHandler {
        - {static} logger: Logger
        --
        # canHandle(exception: Exception): boolean
        # doHandle(exception: Exception): void
    }

    class UserCredentialExceptionHandler {
        - {static} logger: Logger
        --
        # canHandle(exception: Exception): boolean
        # doHandle(exception: Exception): void
    }

    ExceptionHandler <|-- AuthenticationExceptionHandler
    ExceptionHandler <|-- UserExceptionHandler
    ExceptionHandler <|-- CourseExceptionHandler
    ExceptionHandler <|-- ToDoListExceptionHandler
    ExceptionHandler <|-- TimerExceptionHandler
    ExceptionHandler <|-- CalendarExceptionHandler
    ExceptionHandler <|-- UserCredentialExceptionHandler

    note right of ExceptionHandler
        Template Method Pattern:
        Base class for domain-specific
        exception logging

        Subclasses implement:
        - canHandle(): Check exception type
        - doHandle(): Log exception details

        Note: GlobalExceptionHandler
        actually handles HTTP responses,
        these handlers are for logging only
    end note
}

