' ============================================
' DTOs - Timer Domain
' ============================================
package "DTOs - Timer Domain" <<Rectangle>> #LightCoral {
    class TimerDTO {
        - id: UUID
        - userId: UUID
        - courseTaskId: UUID
        - startTime: Instant
        - endTime: Instant
        - durationMillis: long
        - status: TimerStatus
        --
        # TimerDTO(builder: TimerDTOBuilder)
        + {static} builder(): TimerDTOBuilder
        + getId(): UUID
        + getUserId(): UUID
        + getCourseTaskId(): UUID
        + getStartTime(): Instant
        + getEndTime(): Instant
        + getDurationMillis(): long
        + getStatus(): TimerStatus
        + getDurationSeconds(): long
    }

    class TimerDTOBuilder {
        - id: UUID
        - userId: UUID
        - courseTaskId: UUID
        - startTime: Instant
        - endTime: Instant
        - durationMillis: long
        - status: TimerStatus
        --
        + id(id: UUID): TimerDTOBuilder
        + userId(userId: UUID): TimerDTOBuilder
        + courseTaskId(taskId: UUID): TimerDTOBuilder
        + startTime(time: Instant): TimerDTOBuilder
        + endTime(time: Instant): TimerDTOBuilder
        + durationMillis(millis: long): TimerDTOBuilder
        + status(status: TimerStatus): TimerDTOBuilder
        + build(): TimerDTO
    }

    class TaskTimerSummaryDTO {
        - courseTaskId: UUID
        - totalTimeMillis: long
        - sessionCount: int
        - sessions: List<TimerDTO>
        - activeSession: TimerDTO
        --
        # TaskTimerSummaryDTO(builder: TaskTimerSummaryDTOBuilder)
        + {static} builder(): TaskTimerSummaryDTOBuilder
        + getCourseTaskId(): UUID
        + getTotalTimeMillis(): long
        + getTotalTimeSeconds(): long
        + getSessionCount(): int
        + getSessions(): List<TimerDTO>
        + getActiveSession(): TimerDTO
        + hasActiveSession(): boolean
    }

    class TaskTimerSummaryDTOBuilder {
        - courseTaskId: UUID
        - totalTimeMillis: long
        - sessionCount: int
        - sessions: List<TimerDTO>
        - activeSession: TimerDTO
        --
        + courseTaskId(taskId: UUID): TaskTimerSummaryDTOBuilder
        + totalTimeMillis(millis: long): TaskTimerSummaryDTOBuilder
        + sessionCount(count: int): TaskTimerSummaryDTOBuilder
        + sessions(sessions: List<TimerDTO>): TaskTimerSummaryDTOBuilder
        + activeSession(session: TimerDTO): TaskTimerSummaryDTOBuilder
        + build(): TaskTimerSummaryDTO
    }

    TimerDTO --> TimerDTOBuilder : creates
    TaskTimerSummaryDTO o--> TimerDTO : contains
    TaskTimerSummaryDTO --> TaskTimerSummaryDTOBuilder : creates
    TimerDTOBuilder ..> TimerDTO : builds
    TaskTimerSummaryDTOBuilder ..> TaskTimerSummaryDTO : builds
}

' ============================================
' DTOs - Calendar Domain
' ============================================
package "DTOs - Calendar Domain" <<Rectangle>> #PeachPuff {
    class CalendarItemDTO {
        - date: Instant
        - sourceType: String
        - title: String
        - status: String
        - sourceId: String
        - taskId: String
        --
        # CalendarItemDTO(builder: CalendarItemDTOBuilder)
        + {static} builder(): CalendarItemDTOBuilder
        + getDate(): Instant
        + getSourceType(): String
        + getTitle(): String
        + getStatus(): String
        + getSourceId(): String
        + getTaskId(): String
    }

    class CalendarItemDTOBuilder {
        - date: Instant
        - sourceType: String
        - title: String
        - status: String
        - sourceId: String
        - taskId: String
        --
        + date(date: Instant): CalendarItemDTOBuilder
        + sourceType(sourceType: String): CalendarItemDTOBuilder
        + title(title: String): CalendarItemDTOBuilder
        + status(status: String): CalendarItemDTOBuilder
        + sourceId(sourceId: String): CalendarItemDTOBuilder
        + taskId(taskId: String): CalendarItemDTOBuilder
        + build(): CalendarItemDTO
    }

    CalendarItemDTO --> CalendarItemDTOBuilder : creates
    CalendarItemDTOBuilder ..> CalendarItemDTO : builds

    note right of CalendarItemDTO
        Aggregation DTO:
        Combines tasks from multiple sources
        - sourceType: "COURSE" or "TODO_LIST"
        - sourceId: Course/ToDoList UUID
        - taskId: Task UUID

        Used by CalendarService to aggregate
        deadlines from different domains
    end note
}

' ============================================
' ADAPTER PATTERN - Entity to DTO Conversion
' ============================================
package "Adapter Pattern - Entity-DTO Conversion" <<Rectangle>> #Lavender {
    class UserAdapter <<Adapter>> {
        + {static} toDTO(entity: User): UserDTO
        + {static} toDTOList(entities: List<User>): List<UserDTO>
    }

    class CourseAdapter <<Adapter>> {
        + {static} toDTO(entity: Course): CourseDTO
        + {static} toDTOList(entities: List<Course>): List<CourseDTO>
    }

    class CourseTaskAdapter <<Adapter>> {
        + {static} toDTO(entity: CourseTask): CourseTaskDTO
        + {static} toDTOList(entities: List<CourseTask>): List<CourseTaskDTO>
    }

    class ToDoListAdapter <<Adapter>> {
        + {static} toDTO(entity: ToDoList): ToDoListDTO
        + {static} toDTOList(entities: List<ToDoList>): List<ToDoListDTO>
    }

    class ToDoListTaskAdapter <<Adapter>> {
        + {static} toDTO(entity: ToDoListTask): ToDoListTaskDTO
        + {static} toDTOList(entities: List<ToDoListTask>): List<ToDoListTaskDTO>
    }

    class TimerAdapter <<Adapter>> {
        + {static} toDTO(entity: TaskTimer): TimerDTO
        + {static} toDTOList(entities: List<TaskTimer>): List<TimerDTO>
    }

    UserAdapter ..> UserDTO : creates
    CourseAdapter ..> CourseDTO : creates
    CourseAdapter ..> CourseTaskAdapter : uses
    CourseTaskAdapter ..> CourseTaskDTO : creates
    ToDoListAdapter ..> ToDoListDTO : creates
    ToDoListAdapter ..> ToDoListTaskAdapter : uses
    ToDoListTaskAdapter ..> ToDoListTaskDTO : creates
    TimerAdapter ..> TimerDTO : creates
    TimerAdapter ..> TaskTimerSummaryDTO : creates

    note right of UserAdapter
        Adapter Pattern:
        - Converts User entity to UserDTO
        - Isolates domain layer from presentation
        - Static utility methods for conversion
    end note

    note right of CourseAdapter
        Delegates to CourseTaskAdapter
        for nested task conversion
    end note
}

' ============================================
' STRATEGY PATTERN - Sanitization
' ============================================
package "Strategy Pattern - Data Sanitization" <<Rectangle>> #LightSteelBlue {
    interface SanitizationStrategy <<interface>> {
        + sanitize(value: String): String
    }

    class EmailSanitizationStrategy {
        + sanitize(value: String): String
    }

    class NameSanitizationStrategy {
        + sanitize(value: String): String
    }

    class CodeSanitizationStrategy {
        + sanitize(value: String): String
    }

    class TrimSanitizationStrategy {
        + sanitize(value: String): String
    }

    class LowerCaseSanitizationStrategy {
        + sanitize(value: String): String
    }

    class CompositeSanitizationStrategy {
        - strategies: List<SanitizationStrategy>
        + addStrategy(strategy: SanitizationStrategy): void
        + sanitize(value: String): String
    }

    class SignUpRequestSanitizer <<Adapter>> {
        - emailStrategy: EmailSanitizationStrategy
        - nameStrategy: NameSanitizationStrategy
        + sanitize(request: SignUpRequestDTO): SignUpRequestDTO
        + sanitizeName(name: String): String
        + sanitizeEmail(email: String): String
    }

    class CreateCourseRequestSanitizer <<Adapter>> {
        - codeStrategy: CodeSanitizationStrategy
        - nameStrategy: NameSanitizationStrategy
        + sanitizeCode(code: String): String
        + sanitizeName(name: String): String
    }

    SanitizationStrategy <|.. EmailSanitizationStrategy
    SanitizationStrategy <|.. NameSanitizationStrategy
    SanitizationStrategy <|.. CodeSanitizationStrategy
    SanitizationStrategy <|.. TrimSanitizationStrategy
    SanitizationStrategy <|.. LowerCaseSanitizationStrategy
    SanitizationStrategy <|.. CompositeSanitizationStrategy

    CompositeSanitizationStrategy o--> SanitizationStrategy : aggregates

    SignUpRequestSanitizer o--> EmailSanitizationStrategy : uses
    SignUpRequestSanitizer o--> NameSanitizationStrategy : uses
    CreateCourseRequestSanitizer o--> CodeSanitizationStrategy : uses
    CreateCourseRequestSanitizer o--> NameSanitizationStrategy : uses

    SignUpRequestSanitizer ..> SignUpRequestDTO : sanitizes
    CreateCourseRequestSanitizer --> CourseDTO : sanitizes

    note right of CompositeSanitizationStrategy
        Composite Pattern:
        Chains multiple sanitization strategies
        Example: Trim → LowerCase → Validate
    end note
}

' Layout hints
UserDTO -[hidden]down-> CourseDTO
CourseDTO -[hidden]down-> ToDoListDTO
ToDoListDTO -[hidden]down-> TimerDTO
TimerDTO -[hidden]down-> CalendarItemDTO
UserAdapter -[hidden]down-> SanitizationStrategy

@enduml
