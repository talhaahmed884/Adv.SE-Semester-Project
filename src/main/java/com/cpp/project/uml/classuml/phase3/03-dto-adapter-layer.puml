@startuml DTO and Adapter Pattern Layer
!theme plain
skinparam dpi 300
skinparam linetype ortho
skinparam groupInheritance 2
skinparam nodesep 70
skinparam ranksep 70

title Studently - DTO & Adapter Pattern Layer\n(Entity-DTO Conversion with Builder Pattern)

' ============================================
' DTOs - User Domain
' ============================================
package "DTOs - User Domain" <<Rectangle>> #LightBlue {
    class UserDTO {
        - id: UUID
        - name: String
        - email: String
        - createdAt: LocalDateTime
        - updatedAt: LocalDateTime
        --
        # UserDTO(builder: UserDTOBuilder)
        + {static} builder(): UserDTOBuilder
        + getId(): UUID
        + getName(): String
        + getEmail(): String
        + getCreatedAt(): LocalDateTime
        + getUpdatedAt(): LocalDateTime
    }

    class UserDTOBuilder {
        - id: UUID
        - name: String
        - email: String
        - createdAt: LocalDateTime
        - updatedAt: LocalDateTime
        --
        + id(id: UUID): UserDTOBuilder
        + name(name: String): UserDTOBuilder
        + email(email: String): UserDTOBuilder
        + createdAt(createdAt: LocalDateTime): UserDTOBuilder
        + updatedAt(updatedAt: LocalDateTime): UserDTOBuilder
        + build(): UserDTO
    }

    class SignUpRequestDTO {
        - name: String
        - email: String
        - password: String
        --
        + SignUpRequestDTO(name: String, email: String, password: String)
        + getName(): String
        + getEmail(): String
        + getPassword(): String
    }

    class LoginRequestDTO {
        - email: String
        - password: String
        --
        + LoginRequestDTO(email: String, password: String)
        + getEmail(): String
        + getPassword(): String
    }

    UserDTO --> UserDTOBuilder : creates
    UserDTOBuilder ..> UserDTO : builds
}

' ============================================
' DTOs - Course Domain
' ============================================
package "DTOs - Course Domain" <<Rectangle>> #LightGreen {
    class CourseDTO {
        - id: UUID
        - userId: UUID
        - code: String
        - name: String
        - tasks: List<CourseTaskDTO>
        - createdAt: Instant
        - updatedAt: Instant
        --
        # CourseDTO(builder: CourseDTOBuilder)
        + {static} builder(): CourseDTOBuilder
        + getId(): UUID
        + getUserId(): UUID
        + getCode(): String
        + getName(): String
        + getTasks(): List<CourseTaskDTO>
        + getProgress(): int
    }

    class CourseDTOBuilder {
        - id: UUID
        - userId: UUID
        - code: String
        - name: String
        - tasks: List<CourseTaskDTO>
        - createdAt: Instant
        - updatedAt: Instant
        --
        + id(id: UUID): CourseDTOBuilder
        + userId(userId: UUID): CourseDTOBuilder
        + code(code: String): CourseDTOBuilder
        + name(name: String): CourseDTOBuilder
        + tasks(tasks: List<CourseTaskDTO>): CourseDTOBuilder
        + createdAt(createdAt: Instant): CourseDTOBuilder
        + updatedAt(updatedAt: Instant): CourseDTOBuilder
        + build(): CourseDTO
    }

    class CourseTaskDTO {
        - id: UUID
        - name: String
        - description: String
        - deadline: Instant
        - status: TaskStatus
        - progress: int
        - createdAt: Instant
        - updatedAt: Instant
        --
        # CourseTaskDTO(builder: CourseTaskDTOBuilder)
        + {static} builder(): CourseTaskDTOBuilder
        + getId(): UUID
        + getName(): String
        + getDescription(): String
        + getDeadline(): Instant
        + getStatus(): TaskStatus
        + getProgress(): int
    }

    class CourseTaskDTOBuilder {
        - id: UUID
        - name: String
        - description: String
        - deadline: Instant
        - status: TaskStatus
        - progress: int
        --
        + id(id: UUID): CourseTaskDTOBuilder
        + name(name: String): CourseTaskDTOBuilder
        + description(description: String): CourseTaskDTOBuilder
        + deadline(deadline: Instant): CourseTaskDTOBuilder
        + status(status: TaskStatus): CourseTaskDTOBuilder
        + progress(progress: int): CourseTaskDTOBuilder
        + build(): CourseTaskDTO
    }

    CourseDTO o--> CourseTaskDTO : contains
    CourseDTO --> CourseDTOBuilder : creates
    CourseTaskDTO --> CourseTaskDTOBuilder : creates
    CourseDTOBuilder ..> CourseDTO : builds
    CourseTaskDTOBuilder ..> CourseTaskDTO : builds
}

